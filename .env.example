# ── Keyroute environment variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in the values from YOUR own
# Supabase project: https://supabase.com/dashboard → Project Settings → API.

# Browser-side Supabase client (Vite only exposes variables prefixed VITE_).
# The project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=your-project-url-here

# The public "anon" key. Safe to expose in the browser — row access is
# enforced by RLS policies, not by hiding this key.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server-side only (never sent to browsers) ────────────────────────────────
# Used by the Vercel-hosted /api proxy function (the "hosted instance" mode).
# When you deploy the gateway as a Supabase Edge Function instead, Supabase
# injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY into it automatically —
# no configuration needed on your side.
SUPABASE_URL=your-project-url-here

# The service_role key. BYPASSES all RLS policies — server-side use only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional, hosted-instance only: public origin of YOUR hosted dashboard
# (no trailing slash). Affects only the example base URLs shown on the docs
# page in "Hosted instance" mode. Self-hosted installs don't need it — after
# Deploy Gateway, your gateway URL is
# https://<your-project-ref>.supabase.co/functions/v1/gateway.
VITE_APP_BASE_URL=http://localhost:3000
